{
  "name": "kbrowser",
  "productName": "KBrowser",
  "version": "0.2.0",
  "description": "Classic-style Chromium browser",
  "main": "main.js",
  "author": "KBrowser",
  "license": "UNLICENSED",
  "scripts": {
    "dist": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.kbrowser.app",
    "productName": "KBrowser",
    "asar": true,
    "files": ["main.js", "preload.js", "index.html", "package.json", "icon.ico"],
    "win": {
      "icon": "icon.ico",
      "target": [{"target": "dir", "arch": ["x64"]}]
    }
  }
}
