{
  "name": "kbrowser",
  "productName": "KBrowser",
  "version": "0.1.0",
  "description": "Classic-style Chromium browser",
  "main": "main.js",
  "author": "KBrowser",
  "license": "UNLICENSED",
  "scripts": {"dist": "electron-builder --win portable --x64"},
  "devDependencies": {"electron": "43.3.0", "electron-builder": "26.0.12"},
  "build": {
    "appId": "com.kbrowser.app",
    "productName": "KBrowser",
    "asar": true,
    "files": ["main.js", "preload.js", "index.html", "package.json"],
    "win": {
      "target": [{"target": "portable", "arch": ["x64"]}],
      "artifactName": "KBrowser.exe"
    }
  }
}
